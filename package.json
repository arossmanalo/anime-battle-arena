    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.5.3",
    "sharp": "^0.35.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
